<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".debug.DemoActivity"
            android:exported="true"
            android:label="@string/demo_app_name"
            android:theme="@style/Theme.BlueHop"
            tools:ignore="ExportedActivity" />

        <receiver
            android:name=".debug.ProtocolSelfTestReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.hddq.bluehop.DEBUG_PROTOCOL_SELF_TEST" />
                <action android:name="org.hddq.bluehop.DEBUG_DUMP_PSK" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
